{
  "name": "youtube-comments",
  "productName": "YouTube Comments",
  "version": "1.0.0",
  "description": "Persistent YouTube discussion reader (development preview)",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "node scripts/forge-verified.cjs package",
    "make": "node scripts/forge-verified.cjs make",
    "make:squirrel": "node scripts/forge-verified.cjs make --platform=win32 --arch=x64 --targets=@electron-forge/maker-squirrel",
    "make:zip": "node scripts/forge-verified.cjs make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "verify:artifacts": "node scripts/verify-artifacts.cjs",
    "test:packaged": "node scripts/smoke-packaged.cjs",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:electron": "node scripts/smoke-electron.cjs && node scripts/smoke-view-restoration.cjs && node scripts/smoke-backup-restore.cjs && node scripts/smoke-reader-actions.cjs && node scripts/smoke-collapse.cjs && node scripts/smoke-selection.cjs",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build --config vite.renderer.config.ts --outDir .vite/renderer-preview"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    },
    "@electron-forge/maker-zip": {
      "cross-zip": "3.1.0"
    }
  },
  "keywords": [],
  "author": {
    "name": "Ilethas",
    "email": "mkkurowski@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "^1.8.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@xmldom/xmldom": "0.9.12",
    "electron": "44.4.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^25.0.1",
    "resedit": "2.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.6",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-virtual": "3.14.13",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
