{
  "name": "youtube-comments",
  "productName": "YouTube Comments",
  "version": "0.3.0",
  "description": "Persistent YouTube discussion reader (development preview)",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "node scripts/forge-verified.cjs package",
    "make": "node scripts/forge-verified.cjs make",
    "make:squirrel": "node scripts/forge-verified.cjs make --platform=win32 --arch=x64 --targets=@electron-forge/maker-squirrel",
    "make:zip": "node scripts/forge-verified.cjs make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "verify:artifacts": "node scripts/verify-artifacts.cjs",
    "test:packaged": "node scripts/smoke-packaged.cjs",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:appearance": "node scripts/smoke-appearance.cjs",
    "test:downloads": "node scripts/smoke-downloads.cjs",
    "test:electron": "node scripts/smoke-downloads.cjs && node scripts/smoke-appearance.cjs && node scripts/smoke-electron.cjs && node scripts/smoke-tab-keyboard.cjs && node scripts/smoke-view-restoration.cjs && node scripts/smoke-backup-restore.cjs && node scripts/smoke-reader-actions.cjs && node scripts/smoke-collapse.cjs && node scripts/smoke-selection.cjs && node scripts/smoke-reader-usability.cjs && node scripts/smoke-thumbnails.cjs && node scripts/smoke-usability-milestone.cjs && node scripts/smoke-window-coordination.cjs && node scripts/smoke-shared-sync.cjs && node scripts/smoke-profile-lifecycle.cjs && node scripts/smoke-profile-quit.cjs && node scripts/smoke-m4-migration.cjs && node scripts/smoke-duplicate-tabs.cjs && node scripts/smoke-native-windows.cjs && node scripts/smoke-tab-transfer.cjs && node scripts/smoke-tab-drag.cjs && node scripts/smoke-reader-polish.cjs && node scripts/smoke-scroll-layout.cjs --notifications",
    "test:tab-keyboard": "node scripts/smoke-tab-keyboard.cjs",
    "test:scroll-layout": "node scripts/smoke-scroll-layout.cjs",
    "test:notifications": "node scripts/smoke-scroll-layout.cjs --notifications",
    "test:profile-lifecycle": "node scripts/smoke-profile-lifecycle.cjs && node scripts/smoke-profile-quit.cjs",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build --config vite.renderer.config.ts --outDir .vite/renderer-preview",
    "test:m4-migration": "node scripts/smoke-m4-migration.cjs",
    "test:shared-sync": "node scripts/smoke-shared-sync.cjs",
    "test:window-coordination": "node scripts/smoke-window-coordination.cjs",
    "test:m5": "node scripts/smoke-duplicate-tabs.cjs",
    "test:m6": "node scripts/smoke-native-windows.cjs",
    "test:m7": "node scripts/smoke-tab-transfer.cjs",
    "test:m8": "node scripts/smoke-tab-drag.cjs",
    "test:m82": "node scripts/smoke-reader-polish.cjs",
    "test:m91": "node scripts/profile-multi-window.cjs --label=verification --samples=1 --stress",
    "profile:m91": "node scripts/profile-multi-window.cjs --label=current --samples=3 --stress"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    },
    "@electron-forge/maker-zip": {
      "cross-zip": "3.1.0"
    }
  },
  "keywords": [],
  "author": {
    "name": "Ilethas",
    "email": "mkkurowski@gmail.com"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "^1.8.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@xmldom/xmldom": "0.9.12",
    "electron": "44.4.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^25.0.1",
    "resedit": "2.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.6",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-virtual": "3.14.13",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
